{
  "name": "iptv-player-desktop",
  "productName": "IPTV Player",
  "version": "0.1.0",
  "description": "IPTV Player for Windows, macOS and Linux",
  "author": "Youssef Rajeh",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.yrajeh.iptvplayer",
    "productName": "IPTV Player",
    "directories": { "output": "out" },
    "files": ["main.cjs", "preload.cjs", "app/**/*", "icon.png"],
    "icon": "icon.png",
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.entertainment" },
    "linux": { "target": ["AppImage", "deb"], "category": "AudioVideo" }
  }
}
